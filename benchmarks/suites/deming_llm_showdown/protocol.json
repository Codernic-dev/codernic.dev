      ],
      "models": [
        "Qwen2.5-Coder-1.5B-Instruct-Q4_K_M.gguf",
        "Meta-Llama-3.1-8B-Instruct-Q4_K_M.gguf",
        "Qwen2.5-Coder-32B-Instruct-Q4_K_M.gguf"
      ]
