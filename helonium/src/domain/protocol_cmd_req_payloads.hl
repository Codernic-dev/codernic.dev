    pub project_id: Option<str>,
    pub llm_id: Option<str>,
    pub use_rag: Option<bool>,
    pub auto_pilot: Option<bool>,
    pub current_mode: Option<str>,
    pub erathos_schema_json: Option<str>,
}

#[derive(Copy)]
pub struct UpdateSessionSchemaPayload {
    pub session_id: str,
    pub schema_json: str,
    pub project_id: Option<str>,
}

