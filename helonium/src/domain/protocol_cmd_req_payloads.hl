// Payload structs for CommandRequest variants (crates/protocol/src/commands.rs).

#[derive(Copy)]
pub struct ExecuteAskPayload {
    pub task_id: str,
    pub model_id: str,
    pub messages_json: str,
    pub max_tokens: i64,
    pub use_rag: bool,
    pub route_profile: Option<str>,
    pub project_id: Option<str>,
    pub auth_token: Option<Secret<str>>,
}

#[derive(Copy)]
pub struct SessionTargetPayload {
    pub id: str,
    pub new_name: Option<str>,
    pub project_id: Option<str>,
}

#[derive(Copy)]
pub struct UpdateSessionConfigPayload {
