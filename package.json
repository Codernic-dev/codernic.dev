{
  "name": "codernic-monorepo",
  "private": true,
  "description": "Codernic Sovereign AI Platform (Public Workspace)",
  "scripts": {
    "dev:ui": "pnpm -C apps/codernic-ui dev",
    "build:ui": "pnpm -C apps/codernic-ui build",
    "check:all": "cargo check && pnpm run -r lint",
    "test:all": "cargo test && pnpm run -r test"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "zod": "^4.4.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "overrides": {
      "@atomos-web/structura-core": "^2.3.2",
      "@binaryjack/formular.dev": "^2.3.2"
    }
  }
}
